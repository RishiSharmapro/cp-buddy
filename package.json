{
  "name": "cp-buddy",
  "publisher":"RishiSharmaPro",
  "displayName": "CP-buddy",
  "description": "A VS Code companion for competitive programmers to fetch and run test cases with ease.",  
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.96.0"
  },
  "keywords": [
  "competitive programming",
  "competitive programmer",
  "cp",
  "test cases",
  "coding",
  "programming",
  "codeforces",
  "vscode",
  "cpp",
  "c++",
  "python"
],
  "categories": [
    "Other"
  ],
  "icon": "CP-BUDDY.png",
  "activationEvents": [
    "onCommand:cpBuddy.installLanguage"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cp-buddy.helloWorld",
        "title": "Hello World",
        "category": "Cp-buddy"
      },
      {
        "command": "cp-buddy.installLanguage",
        "title": "Install Language",
        "category": "Cp-buddy"
      },
      {
        "command": "cp-buddy.runTestCases",
        "title": "Run Test Cases",
        "category": "Cp-buddy",
        "icon": {
          "light": "./button/web/light.png",
          "dark": "./dark.png"
        }
      },
      {
        "command": "cp-buddy.refetchTestCases",
        "title": "Refetch Test Cases (Bypass Cache)",
        "category": "Cp-buddy"
      },
      {
        "command": "cp-buddy.clearCache",
        "title": "Clear Test Case Cache",
        "category": "Cp-buddy"
      },
      {
        "command": "cp-buddy.setCustomCommand",
        "title": "Configure Custom Command for Language",
        "category": "Cp-buddy"
      }
    ],
    "configuration": {
      "title": "CP-Buddy",
      "properties": {
        "cp-buddy.cppCompilerPath": {
          "type": "string",
          "default": "",
          "description": "Custom path or name of the C++ compiler (e.g. g++-16, /opt/homebrew/bin/g++-16)"
        },
        "cp-buddy.customCompileCommands": {
          "type": "object",
          "default": {},
          "description": "Custom compile command templates per language. Placeholders: {file}, {bin}, {dir}, {baseName}"
        },
        "cp-buddy.customRunCommands": {
          "type": "object",
          "default": {},
          "description": "Custom run command templates per language. Placeholders: {bin}, {input}, {output}, {file}, {dir}, {baseName}"
        }
      }
    },
    "keybindings": [
      {
        "command": "cp-buddy.runTestCases",
        "key": "ctrl+'",
        "mac": "cmd+'",
        "when": "editorTextFocus"
      },
      {
        "command": "cp-buddy.refetchTestCases",
        "key": "ctrl+shift+'",
        "mac": "cmd+shift+'",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cp-buddy.runTestCases",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "cp-buddy.refetchTestCases",
          "when": "editorTextFocus",
          "group": "1_modification"
        }
      ],
      "editor/context": [
        {
          "command": "cp-buddy.runTestCases",
          "when": "editorTextFocus",
          "group": "cp-buddy@1"
        },
        {
          "command": "cp-buddy.refetchTestCases",
          "when": "editorTextFocus",
          "group": "cp-buddy@2"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rishisharmapro/cp-buddy"
  },
  "scripts": {
    "lint": "eslint .",
    "test:unit": "mocha test/unit.test.js",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.16.0"
  },
  "dependencies": {
    "puppeteer": "^24.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
